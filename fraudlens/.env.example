# Copy to .env (git-ignored) and adjust. Never commit real keys.
# Optional single bootstrap API key; prefer keys created in the app (Admin -> API keys).
FRAUDLENS_API_KEY=
# SQLite file for users, API keys, cases and audit (default data/fraudlens.sqlite)
# FRAUDLENS_DB=data/fraudlens.sqlite
# Alternative config file
# FRAUDLENS_CONFIG=configs/default.yaml
